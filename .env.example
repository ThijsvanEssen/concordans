# URL of the Concordans backend API. Change this to point at a staging or production host.
# PUBLIC_LAWGRAPH_API_BASE_URL is still read as a fallback.
PUBLIC_CONCORDANS_API_BASE_URL=http://localhost:8000

# PostHog analytics (EU cloud). Get your key at posthog.com → Project settings → Project API key.
# Leave empty to disable analytics entirely.
VITE_POSTHOG_KEY=
