# URL of the LawGraph API. Change this to point at a staging or production host.
PUBLIC_CONCORDANS_API_BASE_URL=http://localhost:8000

# Key for the API's write routes (watches). Same value as LAWGRAPH_WRITE_API_KEY of the API.
# Read by the server routes under /proxy only; without it writes answer 503.
# Never give it a PUBLIC_ prefix: that would ship it to the browser.
LAWGRAPH_WRITE_API_KEY=

# PostHog analytics (EU cloud). Get your key at posthog.com → Project settings → Project API key.
# Leave empty to disable analytics entirely.
VITE_POSTHOG_KEY=
